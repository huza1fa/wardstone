WARDSTONE_DATABASE_URL=postgres://wardstone_admin:${WARDSTONE_POSTGRES_PASSWORD}@localhost:5432/wardstone?sslmode=disable
WARDSTONE_POSTGRES_USER=wardstone_admin
WARDSTONE_POSTGRES_PASSWORD=replace-with-a-strong-password
WARDSTONE_LISTEN_ADDRESS=127.0.0.1:8080
WARDSTONE_MODE=SHADOW
WARDSTONE_CONFIG_FILE=examples/wardstone.yaml
WARDSTONE_WORKERS=4
WARDSTONE_MAX_COLLECTORS=4
WARDSTONE_COLLECTOR_TIMEOUT=10s
WARDSTONE_MODEL_TIMEOUT=60s
WARDSTONE_JOB_LEASE=2m
WARDSTONE_APPROVAL_LIFETIME=24h
WARDSTONE_MAX_HANDOFFS=3
WARDSTONE_MAX_FOLLOW_UP_QUESTIONS=3
WARDSTONE_JIRA_WEBHOOK_SECRET=
WARDSTONE_JIRA_BASE_URL=
WARDSTONE_JIRA_EMAIL=
WARDSTONE_JIRA_API_TOKEN=
WARDSTONE_OPERATOR_TOKEN=change-me-too
WARDSTONE_API_URL=http://127.0.0.1:8080
WARDSTONE_OPERATOR_ACTOR=
WARDSTONE_GOOGLE_BASE_URL=https://admin.googleapis.com/admin/directory/v1
WARDSTONE_GOOGLE_ACCESS_TOKEN=
WARDSTONE_OPENAI_BASE_URL=http://localhost:11434/v1
WARDSTONE_OPENAI_API_KEY=
WARDSTONE_OPENAI_MODEL=
